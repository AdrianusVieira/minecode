{
  "name": "minecode",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -k \"tsx watch server/index.ts\" \"vite --host 127.0.0.1 --port 5177\"",
    "build": "tsc --noEmit && tsc --noEmit --project tsconfig.server.json && vite build",
    "start": "npm run build && npm run server",
    "server": "tsx server/index.ts",
    "test": "tsx --test server/*.test.ts tests/*.test.ts",
    "preview": "vite preview --host 127.0.0.1"
  },
  "dependencies": {
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "three": "0.186.1",
    "better-sqlite3": "11.10.0"
  },
  "devDependencies": {
    "@types/node": "26.6.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/three": "0.186.0",
    "@vitejs/plugin-react": "6.1.1",
    "concurrently": "^9.2.5",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vite": "8.3.1",
    "@types/better-sqlite3": "9.6.0"
  }
}
